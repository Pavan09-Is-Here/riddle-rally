{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Worker hosting for the public Riddle Rally game.
  "name": "riddle-rally",
  "workers_dev": true,

  // Bundled by `bun run build` (see scripts/build.mjs). The deploy rediscovers
  // the built entry and points `main` at it itself.
  "main": "dist/worker/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files serve FIRST (so `/` and `/client.js` never reach the Worker);
  // anything else — notably `/ws` — falls through to it.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "vars": {},

  // The room. `new_sqlite_classes` is required for a new DO class — the SQLite
  // backend is the only one available to new namespaces, and it is what makes
  // per-room `ctx.storage` cheap.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
